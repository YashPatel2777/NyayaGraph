# Draft (Phase 0). Every variable from 1.3; copy to .env and fill in the required values.
# Never commit .env.

APP_ENV=dev
# Keep loopback: v1 has no authentication (3.2)
APP_HOST=127.0.0.1
DEFAULT_USER_ID=local

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# required
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

OLLAMA_URL=http://localhost:11434
# Locked values, checked against the Meta node (2.2, R-08)
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# required
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Empty means the FlashRank library default (ms-marco-TinyBERT-L-2-v2). SC-21: the operator
# chose ms-marco-MiniLM-L-12-v2 after the Phase 4 evaluation (O-7 in docs/README.md).
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
WHISPER_MODEL=medium
OCR_LANGS=en,hi
UPLOAD_DIR=./data/uploads

ENABLE_GUARDRAILS=false
# Initial values; calibrate on the evaluation set (R-24)
LINK_MIN_SCORE=0.60
RERANK_HIGH=0.5

# Comma-separated; empty means CORS is off. No wildcard when APP_ENV=prod
CORS_ORIGINS=
LOGFIRE_TOKEN=
